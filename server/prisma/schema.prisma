generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  EXAMINER
  ADMIN
}

enum ExamStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  COMPLETED
}

enum QuestionType {
  MCQ
  SUBJECTIVE
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  TIMED_OUT
}

enum FinalizationStatus {
  PENDING
  FINALIZED
}

enum EvaluationStatus {
  PENDING_REVIEW
  FINALIZED
}

enum PublicationStatus {
  UNPUBLISHED
  PUBLISHED
}

enum EventReviewStatus {
  OPEN
  REVIEWED
}

model User {
  id               String            @id @default(uuid()) @db.Uuid
  name             String            @db.VarChar(160)
  email            String            @unique @db.VarChar(320)
  passwordHash     String            @map("password_hash") @db.VarChar(255)
  role             UserRole          @default(STUDENT)
  active           Boolean           @default(true)
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  examsCreated     Exam[]            @relation("ExamCreator")
  attempts         Attempt[]         @relation("AttemptStudent")
  results          Result[]
  activities       ActivityLog[]     @relation("ActivityActor")
  evaluatedAnswers AttemptAnswer[]   @relation("AnswerEvaluator")
  reviewedEvents   ProctoringEvent[] @relation("EventReviewer")
  sessions         AuthSession[]
  invitations      UserInvitation[]  @relation("InvitationCreator")

  @@index([role, active])
  @@map("users")
}

model Exam {
  id              String     @id @default(uuid()) @db.Uuid
  title           String     @db.VarChar(240)
  subject         String     @db.VarChar(160)
  description     String?    @db.Text
  instructions    String?    @db.Text
  durationMinutes Int        @map("duration_minutes")
  availableFrom   DateTime?  @map("available_from")
  availableUntil  DateTime?  @map("available_until")
  status          ExamStatus @default(DRAFT)
  createdById     String     @map("created_by_id") @db.Uuid
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  createdBy       User       @relation("ExamCreator", fields: [createdById], references: [id], onDelete: Restrict)
  questions       Question[]
  attempts        Attempt[]
  results         Result[]

  @@index([status, availableFrom, availableUntil])
  @@index([createdById, updatedAt])
  @@map("exams")
}

model Question {
  id            String          @id @default(uuid()) @db.Uuid
  examId        String          @map("exam_id") @db.Uuid
  text          String          @db.Text
  type          QuestionType
  marks         Decimal         @db.Decimal(8, 2)
  displayOrder  Int             @map("display_order")
  options       Json?
  correctAnswer Json?           @map("correct_answer")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  exam          Exam            @relation(fields: [examId], references: [id], onDelete: Cascade)
  answers       AttemptAnswer[]

  @@unique([examId, displayOrder])
  @@index([examId, displayOrder])
  @@map("questions")
}

model Attempt {
  id                 String             @id @default(uuid()) @db.Uuid
  studentId          String             @map("student_id") @db.Uuid
  examId             String             @map("exam_id") @db.Uuid
  startedAt          DateTime           @default(now()) @map("started_at")
  deadlineAt         DateTime           @map("deadline_at")
  submittedAt        DateTime?          @map("submitted_at")
  status             AttemptStatus      @default(IN_PROGRESS)
  finalizationStatus FinalizationStatus @default(PENDING) @map("finalization_status")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  student            User               @relation("AttemptStudent", fields: [studentId], references: [id], onDelete: Restrict)
  exam               Exam               @relation(fields: [examId], references: [id], onDelete: Restrict)
  answers            AttemptAnswer[]
  result             Result?
  proctoringEvents   ProctoringEvent[]

  @@unique([studentId, examId])
  @@unique([id, studentId, examId])
  @@index([examId, status])
  @@index([studentId, startedAt])
  @@index([status, deadlineAt])
  @@map("attempts")
}

model AttemptAnswer {
  attemptId     String    @map("attempt_id") @db.Uuid
  questionId    String    @map("question_id") @db.Uuid
  answer        Json
  savedAt       DateTime  @default(now()) @map("saved_at")
  awardedMarks  Decimal?  @map("awarded_marks") @db.Decimal(8, 2)
  feedback      String?   @db.Text
  evaluatedById String?   @map("evaluated_by_id") @db.Uuid
  evaluatedAt   DateTime? @map("evaluated_at")
  attempt       Attempt   @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question      Question  @relation(fields: [questionId], references: [id], onDelete: Restrict)
  evaluatedBy   User?     @relation("AnswerEvaluator", fields: [evaluatedById], references: [id], onDelete: SetNull)

  @@id([attemptId, questionId])
  @@index([questionId])
  @@index([evaluatedById])
  @@map("attempt_answers")
}

model Result {
  id                String            @id @default(uuid()) @db.Uuid
  studentId         String            @map("student_id") @db.Uuid
  examId            String            @map("exam_id") @db.Uuid
  attemptId         String            @unique @map("attempt_id") @db.Uuid
  obtainedMarks     Decimal           @default(0) @map("obtained_marks") @db.Decimal(8, 2)
  maximumMarks      Decimal           @map("maximum_marks") @db.Decimal(8, 2)
  evaluationStatus  EvaluationStatus  @default(FINALIZED) @map("evaluation_status")
  publicationStatus PublicationStatus @default(UNPUBLISHED) @map("publication_status")
  publishedAt       DateTime?         @map("published_at")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  student           User              @relation(fields: [studentId], references: [id], onDelete: Restrict)
  exam              Exam              @relation(fields: [examId], references: [id], onDelete: Restrict)
  attempt           Attempt           @relation(fields: [attemptId, studentId, examId], references: [id, studentId, examId], onDelete: Restrict)

  @@unique([studentId, examId])
  @@unique([attemptId, studentId, examId])
  @@index([examId, publicationStatus, createdAt])
  @@index([studentId, publicationStatus, createdAt])
  @@map("results")
}

model ProctoringEvent {
  id           String            @id @default(uuid()) @db.Uuid
  attemptId    String            @map("attempt_id") @db.Uuid
  type         String            @db.VarChar(100)
  metadata     Json?
  occurredAt   DateTime          @default(now()) @map("occurred_at")
  reviewStatus EventReviewStatus @default(OPEN) @map("review_status")
  reviewedById String?           @map("reviewed_by_id") @db.Uuid
  reviewedAt   DateTime?         @map("reviewed_at")
  attempt      Attempt           @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  reviewedBy   User?             @relation("EventReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([attemptId, occurredAt])
  @@index([reviewStatus, occurredAt])
  @@map("proctoring_events")
}

model ActivityLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String   @db.VarChar(120)
  entityType String   @map("entity_type") @db.VarChar(80)
  entityId   String?  @map("entity_id") @db.VarChar(120)
  metadata   Json?
  occurredAt DateTime @default(now()) @map("occurred_at")
  actor      User?    @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([occurredAt])
  @@index([actorId, occurredAt])
  @@index([entityType, entityId])
  @@map("activity_logs")
}

model AuthSession {
  id        String    @id @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model UserInvitation {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @db.VarChar(160)
  email       String    @db.VarChar(320)
  role        UserRole
  tokenHash   String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt   DateTime  @map("expires_at")
  usedAt      DateTime? @map("used_at")
  invitedById String    @map("invited_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  invitedBy   User      @relation("InvitationCreator", fields: [invitedById], references: [id], onDelete: Restrict)

  @@index([email, expiresAt])
  @@index([invitedById, createdAt])
  @@map("user_invitations")
}
