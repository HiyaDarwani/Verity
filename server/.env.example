NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://localhost:5432/verity?schema=public
# Neon supplies DATABASE_URL_UNPOOLED for Prisma migrations; runtime uses the pooled DATABASE_URL above.
DATABASE_URL_UNPOOLED=postgresql://localhost:5432/verity?schema=public
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_EXPIRES_IN=1h
CORS_ORIGIN=http://localhost:5173
BCRYPT_ROUNDS=12
